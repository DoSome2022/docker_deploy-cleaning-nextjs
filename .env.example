# 複製為 .env 再修改（.env 唔會入 git）
# 本地開發同部署共用呢份檔；部署前所有值都要改為真實資料

# ── 本地開發用（next dev / prisma 直接讀）──
# 格式：postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://popo:popo123@localhost:5432/popo_db?schema=public"

# ── Auth.js v5 session 簽章金鑰（必填，部署時換成強隨機字串）──
# 生成：openssl rand -base64 32
AUTH_SECRET="change-me"

# ── 部署用（docker compose 讀取；DATABASE_URL 會由 compose 自動組裝）──
POSTGRES_DB=popo_db
POSTGRES_USER=popo
POSTGRES_PASSWORD=請換成強密碼

# ── Redis 限流（fail-open）──
# REDIS_URL 喺 compose 已自動指向 redis://redis:6379；本機開發用 redis://127.0.0.1:6387
REDIS_URL=redis://127.0.0.1:6387
# tRPC API 每 IP 每分鐘最大請求數（0 = 關閉）
RATE_LIMIT_MAX=120
